#!/usr/bin/env python3
"""zflow-tiling-keys — atalhos de janela do jeito do Pop!_OS, no Zorin Tiling Shell.

  Super+setas          foco na janela ao lado
  Super+Shift+setas    move a janela para o espaço ao lado
  Super+Y              liga/desliga o tiling automático (extensão Zorin Flow)

  zflow-tiling-keys apply     aplica (guarda os atalhos atuais antes)
  zflow-tiling-keys restore   volta aos atalhos de antes

O Super+Shift+setas era "mover para outro monitor"; esse atalho é liberado
(e volta no restore).
"""

import json
import os
import sys

from gi.repository import Gio

TILING = "org.gnome.shell.extensions.zorin-tiling-shell"
WM = "org.gnome.desktop.wm.keybindings"
BACKUP = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                      "zorin-flow", "backup-tiling-keys.json")

DIRS = {"left": "Left", "right": "Right", "up": "Up", "down": "Down"}
POP = {
    (TILING, f"focus-window-{d}"): [f"<Super>{k}"] for d, k in DIRS.items()
} | {
    (TILING, f"move-window-{d}"): [f"<Super><Shift>{k}"] for d, k in DIRS.items()
} | {
    (WM, f"move-to-monitor-{d}"): [] for d in DIRS
}


def settings(schema):
    if Gio.SettingsSchemaSource.get_default().lookup(schema, True) is None:
        sys.exit(f"esquema {schema} não encontrado (o Zorin Tiling Shell está instalado?)")
    return Gio.Settings.new(schema)


def apply():
    cache = {}
    if not os.path.exists(BACKUP):
        backup = {f"{s}|{k}": (cache.setdefault(s, settings(s))).get_strv(k) for s, k in POP}
        os.makedirs(os.path.dirname(BACKUP), exist_ok=True)
        with open(BACKUP, "w") as f:
            json.dump(backup, f, indent=2)
    for (s, k), value in POP.items():
        cache.setdefault(s, settings(s)).set_strv(k, value)
    Gio.Settings.sync()
    print("atalhos do Pop aplicados (Super+setas foco, Super+Shift+setas move)")


def restore():
    if not os.path.exists(BACKUP):
        print("nada a restaurar")
        return
    with open(BACKUP) as f:
        backup = json.load(f)
    cache = {}
    for key, value in backup.items():
        s, k = key.split("|", 1)
        cache.setdefault(s, settings(s)).set_strv(k, value)
    Gio.Settings.sync()
    os.remove(BACKUP)
    print("atalhos restaurados")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "apply":
        apply()
    elif cmd == "restore":
        restore()
    else:
        print(__doc__.strip())
        sys.exit(2)
